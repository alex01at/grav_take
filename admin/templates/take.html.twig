{% extends 'partials/base.html.twig' %}

{% set task = grav.uri.param('task') ?: grav.uri.query('task') %}
{% set current_slug = grav.uri.param('slug') ?: grav.uri.query('slug') %}

{% block content %}
    <div class="take-admin">
        <header class="page-header">
            <h1>{{ 'PLUGIN_TAKE.MENU_LABEL'|t }}</h1>
        </header>

        {% if task == 'edit' %}
            {% set event = current_slug != 'new' ? take_events[current_slug] : null %}
            <form method="post" action="{{ base_url }}/take">
                <input type="hidden" name="task" value="save_event">
                <input type="hidden" name="slug" value="{{ event.slug|default('new') }}">

                <div class="form-group">
                    <label>{{ 'PLUGIN_TAKE.EVENT_TITLE'|t }}</label>
                    <input type="text" name="title" value="{{ event.title|default('') }}" required>
                </div>
                <div class="form-group">
                    <label>{{ 'PLUGIN_TAKE.EVENT_DATE'|t }}</label>
                    <input type="date" name="date" value="{{ event.date|default('') }}" required>
                </div>
                <button type="submit" class="button">{{ 'PLUGIN_ADMIN.SAVE'|t }}</button>
                <a href="{{ base_url }}/take" class="button">{{ 'PLUGIN_ADMIN.CANCEL'|t }}</a>
            </form>

            {% if event %}
                <h2>{{ 'PLUGIN_TAKE.ENTRIES'|t }}</h2>
                <table class="take-entries-table">
                    <thead>
                        <tr>
                            <th>{{ 'PLUGIN_TAKE.NAME'|t }}</th>
                            <th>{{ 'PLUGIN_TAKE.EMAIL'|t }}</th>
                            <th>{{ 'PLUGIN_TAKE.ITEMS'|t }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for index, entry in event.entries %}
                        <tr>
                            <form method="post" action="{{ base_url }}/take">
                                <input type="hidden" name="task" value="save_entry">
                                <input type="hidden" name="slug" value="{{ event.slug }}">
                                <input type="hidden" name="index" value="{{ index }}">
                                <td><input type="text" name="name" value="{{ entry.name }}"></td>
                                <td>{{ entry.email }}</td>
                                <td><textarea name="items" rows="2">{{ entry.items|join('\n') }}</textarea></td>
                                <td>
                                    <button type="submit" class="button">{{ 'PLUGIN_ADMIN.SAVE'|t }}</button>
                                </td>
                            </form>
                            <td>
                                <form method="post" action="{{ base_url }}/take" onsubmit="return confirm('{{ 'PLUGIN_TAKE.CONFIRM_DELETE'|t }}');">
                                    <input type="hidden" name="task" value="delete_entry">
                                    <input type="hidden" name="slug" value="{{ event.slug }}">
                                    <input type="hidden" name="index" value="{{ index }}">
                                    <button type="submit" class="button button-danger">{{ 'PLUGIN_ADMIN.DELETE'|t }}</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">{{ 'PLUGIN_TAKE.NO_ENTRIES'|t }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>

                <h3>{{ 'PLUGIN_TAKE.ADD_ENTRY'|t }}</h3>
                <form method="post" action="{{ base_url }}/take">
                    <input type="hidden" name="task" value="save_entry">
                    <input type="hidden" name="slug" value="{{ event.slug }}">
                    <input type="hidden" name="index" value="-1">
                    <div class="form-group">
                        <label>{{ 'PLUGIN_TAKE.NAME'|t }}</label>
                        <input type="text" name="name">
                    </div>
                    <div class="form-group">
                        <label>{{ 'PLUGIN_TAKE.ITEMS'|t }} ({{ 'PLUGIN_TAKE.ONE_PER_LINE'|t }})</label>
                        <textarea name="items" rows="2"></textarea>
                    </div>
                    <button type="submit" class="button">{{ 'PLUGIN_ADMIN.ADD'|t }}</button>
                </form>
            {% endif %}

        {% else %}
            <a href="{{ base_url }}/take?task=edit&slug=new" class="button button-primary">
                {{ 'PLUGIN_TAKE.NEW_EVENT'|t }}
            </a>
            <table class="take-events-table">
                <thead>
                    <tr>
                        <th>{{ 'PLUGIN_TAKE.EVENT_TITLE'|t }}</th>
                        <th>{{ 'PLUGIN_TAKE.EVENT_DATE'|t }}</th>
                        <th>{{ 'PLUGIN_TAKE.ENTRIES'|t }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for slug, event in take_events %}
                    <tr>
                        <td><a href="{{ base_url }}/take?task=edit&slug={{ slug }}">{{ event.title }}</a></td>
                        <td>{{ event.date }}</td>
                        <td>{{ event.entries|length }}</td>
                        <td>
                            <form method="post" action="{{ base_url }}/take" onsubmit="return confirm('{{ 'PLUGIN_TAKE.CONFIRM_DELETE'|t }}');">
                                <input type="hidden" name="task" value="delete_event">
                                <input type="hidden" name="slug" value="{{ slug }}">
                                <button type="submit" class="button button-danger">{{ 'PLUGIN_ADMIN.DELETE'|t }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">{{ 'PLUGIN_TAKE.NO_EVENTS'|t }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
